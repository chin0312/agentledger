# AgentLedger server-side configuration example.
# Never prefix secrets with NEXT_PUBLIC_ or commit a populated env file.

# Compatibility marker only. Explicit /api/demo/* routes are always used for
# demo data; this flag never enables a hidden production fallback.
DEMO_MODE=true

# Optional OKX Open API wallet-data adapter credentials.
# These are needed only for address-based wallet-history requests. The core
# provided-state reasoning engine does not require them.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional project header for OKX configurations that require it.
# The current transaction-history reference authenticates with the three
# credentials above; the adapter sends this header only when it is provided.
OKX_PROJECT_ID=

# OKX chain indexes to query. The current API requires at least one chain.
# Ethereum mainnet is chain index 1.
OKX_CHAINS=1

# Maximum time for each OKX transaction-history request. Retries are bounded.
OKX_TIMEOUT_MS=8000

# x402 facilitator configuration for the two paid Marketplace routes.
# The current implementation reuses the server-side OKX credentials above.

# Public X Layer-compatible EVM receiving address for x402 settlement.
# This is not a private key and must never be replaced with signing material.
AGENTLEDGER_PAY_TO_ADDRESS=
AGENTLEDGER_RECOMMENDATIONS_PRICE_USD=0.01
AGENTLEDGER_POLICY_GUARD_PRICE_USD=0.02

# Manual development smoke-test only; not required by the production runtime.
AGENTLEDGER_BASE_URL=http://localhost:3000
LIVE_TEST_ADDRESS=
LIVE_TEST_MONTHLY_BUDGET=500
